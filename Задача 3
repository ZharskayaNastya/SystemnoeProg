import java.io.File;
import java.io.FileNotFoundException;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) throws FileNotFoundException {
        // Создаём сканер для чтения файла
        Scanner scanner = new Scanner(new File("1111.txt"));

        // Сначала посчитаем количество чисел в файле (первый проход)
        int count = 0;
        while (scanner.hasNextInt()) {
            scanner.nextInt();
            count++;
        }
        scanner.close();

        // Создаём массив нужного размера и снова открываем файл (второй проход)
        int[] numbers = new int[count];
        scanner = new Scanner(new File("1111.txt"));
        int index = 0;
        while (scanner.hasNextInt()) {
            numbers[index] = scanner.nextInt();
            index++;
        }
        scanner.close();


        // ===== ШАГ 1: находим минимальное кратное 37 =====
        // Начинаем с очень большого числа, чтобы любое кратное 37 его "перебило"
        int minMultiple37 = Integer.MAX_VALUE;
        for (int i = 0; i < numbers.length; i++) {
            // Проверяем: делится ли число на 37 без остатка
            if (numbers[i] % 37 == 0) {
                // Если да и оно меньше текущего минимума — обновляем
                if (numbers[i] < minMultiple37) {
                    minMultiple37 = numbers[i];
                }
            }
        }

        // ===== ШАГ 2: находим максимальное кратное 73 =====
        // Начинаем с нуля, чтобы любое кратное 73 его "перебило"
        int maxMultiple73 = 0;
        for (int i = 0; i < numbers.length; i++) {
            // Проверяем: делится ли число на 73 без остатка
            if (numbers[i] % 73 == 0) {
                // Если да и оно больше текущего максимума — обновляем
                if (numbers[i] > maxMultiple73) {
                    maxMultiple73 = numbers[i];
                }
            }
        }

        // ===== ШАГ 3: ищем подходящие пары подряд идущих элементов =====
        int pairCount = 0;              // счётчик найденных пар
        int minSum = Integer.MAX_VALUE; // минимальная сумма среди пар

        // Проходим по всем парам (i, i+1)
        for (int i = 0; i < numbers.length - 1; i++) {
            int a = numbers[i];      // первый элемент пары
            int b = numbers[i + 1];  // второй элемент пары

            // Проверяем условие: ровно ОДНО из двух чисел лежит
            // в диапазоне [minMultiple37, maxMultiple73] (включительно)
            boolean aInside = (a >= minMultiple37 && a <= maxMultiple73);
            boolean bInside = (b >= minMultiple37 && b <= maxMultiple73);

            // Условие "только одно" означает, что ровно одно из двух истинно
            // Это эквивалентно логическому XOR
            if (aInside ^ bInside) {
                pairCount++;
                int sum = a + b;
                if (sum < minSum) {
                    minSum = sum;
                }
            }
        }

        // Выводим результаты
        System.out.println("Количество найденных пар: " + pairCount);
        System.out.println("Минимальная сумма: " + minSum);
    }
}
