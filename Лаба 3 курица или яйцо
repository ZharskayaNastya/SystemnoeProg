public class Main {
    static volatile String lastSpeaker = ""; // Хранит имя потока, который сказал последнее слово
    public static void main(String[] args) {
        Thread chicken = new Thread(() -> { //поток курица
            for (int i = 0; i < 10; i++) {
                System.out.println("Курица");
                lastSpeaker = "Курица"; // запоминаем
                try { Thread.sleep(100); } catch (InterruptedException e) {}
            }
        });

        Thread egg = new Thread(() -> { //поток яйцо
            for (int i = 0; i < 10; i++) {
                System.out.println("Яйцо");
                lastSpeaker = "Яйцо"; // запоминаем
                try { Thread.sleep(100); } catch (InterruptedException e) {}
            }
        });

        chicken.start();
        egg.start();

        try { chicken.join(); } catch (InterruptedException e) {}
        System.out.println("Курица жива? " + chicken.isAlive()); // демонстрация isAlive
        try { egg.join(); } catch (InterruptedException e) {}

        System.out.println("Спор окончен. Победила " + lastSpeaker);
    }
}
